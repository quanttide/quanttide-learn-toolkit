{
  "name": "quanttide-learn",
  "version": "0.1.0",
  "description": "量潮学习管理 TypeScript SDK（Learner × Completion + Schedule + Task 领域模型）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
